# URL pública do site (SEO, sitemap e redirecionamentos de pagamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — sem estas variáveis o app roda em MODO DEMONSTRAÇÃO
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (webhooks e cron). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (cartão)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: preço recorrente já criado no painel (senão é criado dinamicamente, R$ 5/mês)
STRIPE_PRICE_ID=

# Mercado Pago (Pix, boleto e cartão via assinatura/preapproval)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Protege a rota /api/cron/assinaturas (a Vercel envia automaticamente)
CRON_SECRET=
